{
  "name": "thunderbird-local-triage",
  "version": "0.13.13",
  "private": true,
  "type": "module",
  "description": "A local-first Thunderbird extension for automatic email categorization and importance ranking.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "npm run package && node scripts/build-native-host-fossilize.mjs",
